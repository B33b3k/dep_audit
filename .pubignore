# Files to exclude from pub.dev publishing
# (but keep in git repository)

# Development and CI files
.github/
.gitignore
.pubignore
Makefile
codecov.yml

# Documentation for development/setup
AUTOMATION_SETUP.md
CONTRIBUTING.md
AUTHORS.md
GITHUB_SETUP_COMPLETE.md
PUB_DEV_SETUP_GUIDE.md
FINAL_SETUP_STEPS.md

# Build and development artifacts
.dart_tool/
pubspec.lock
coverage/

# Scripts for development/release
scripts/

# Test files (optional - you might want to include these)
# Uncomment the next line if you don't want test files in the package
# test/

# Exclude gitignored but tracked files
.dart_tool/package_config.json
.dart_tool/package_graph.json
.dart_tool/pub/bin/dep_audit/dep_audit.dart-3.9.0.snapshot
.dart_tool/pub/bin/test/test.dart-3.9.0.snapshot
.dart_tool/pub/bin/test/test.dart-3.9.2.snapshot
.dart_tool/test/incremental_kernel.Ly9AZGFydD0zLjA=
.github/workflows/github-packages.yml